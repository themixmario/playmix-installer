<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:Apps2Samsung.Mobile.Localization"
             x:Class="Apps2Samsung.Mobile.Pages.InstallCompletePage"
             Shell.NavBarIsVisible="False"
             Title="{l:Localize InstallationSuccessful}"
             BackgroundColor="{DynamicResource BgColor}">

    <Grid Padding="20" VerticalOptions="Center">
        <Border Padding="20" StrokeThickness="1"
                StrokeShape="RoundRectangle 8"
                Stroke="{DynamicResource HairBrush}"
                BackgroundColor="{DynamicResource SurfaceColor}">
            <VerticalStackLayout Spacing="14" HorizontalOptions="Fill">

                <Label Text="✅" FontSize="40" HorizontalOptions="Center" />

                <Label x:Name="MessageLabel" FontSize="16" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" HorizontalOptions="Center" />

                <!-- Installed under another package id than its own (#1028): why, in one line. -->
                <Label x:Name="NoteLabel" FontSize="14" IsVisible="False"
                       HorizontalTextAlignment="Center" HorizontalOptions="Center" />

                <Label Text="{l:Localize lbleasyRight}" FontSize="14" Opacity="0.7"
                       HorizontalTextAlignment="Center" HorizontalOptions="Center" />

                <Button Text="{l:Localize btn_Close}" Padding="12,12" CornerRadius="12" HeightRequest="48" Margin="0,8,0,0" Clicked="OnCloseClicked" />

            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentPage>
